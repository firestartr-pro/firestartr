# Note: All string values without quotes (")


# From your AWS SSO account.
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - AWS_SESSION_TOKEN
# Required

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Indicates whether you are testing locally, from your machine.
# Truthy value to activate (e.g. 1, not empty string...)
# Optional
IS_DEV_LOCAL_ENVIRONMENT=

# GitHub organization to target
# Required
ORG=

# AWS SSM customer name (required for SSM parameter paths)
# Base paths: /firestartr/{CUSTOMER}/fs-{CUSTOMER}/pem, /firestartr/{CUSTOMER}/fs-{CUSTOMER}/app-id
# Installation ID: /firestartr/{CUSTOMER}/fs-{CUSTOMER}/{ORG}/app-installation-id
# Example: my-customer
# Required
CUSTOMER=

# GitHub App ID (get from GitHub App settings)
# Required for authentication
GITHUB_APP_ID=

# GitHub App Installation ID for your organization
# Required - different for each org
# Find at: https://github.com/organizations/{ORG}/settings/installations
GITHUB_APP_INSTALLATION_ID=

# Firestartr controller Helm chart version
# If not set, uses the local chart from ../charts/charts/firestartr-controller
# If set, uses the published chart from the Helm repository
# Example: 3.1.0
# Optional
CHART_VERSION=

# Firestartr CRDs version
# Example: v1.53.1
# Required
CRDS_VERSION=

# The minimum log level to show.
# Options: error | warn | info | debug | verbose | silly
# Default: info
# Optional
LOG_LEVEL=
