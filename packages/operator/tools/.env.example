# Options for ./deploy-snapshot-on-pre.sh
# Copy this file to packages/operator/tools/.env — the script reads it automatically
# and uses these as the pre-filled defaults for each prompt.
#
# Non-interactive mode (./deploy-snapshot-on-pre.sh --non-interactive) REQUIRES this
# .env to exist; missing values fall back to the defaults below, and SNAPSHOT_BRANCH
# may be overridden per run via the environment (the deploy-snapshot skill sets it).

# Optional: override where the script reads/writes remembered values.
# Defaults to packages/operator/tools/.env (next to the script).
# ENV_FILE=packages/operator/tools/.env

# Temporary clone of firestartr-pre/app-firestartr.
# Relative paths are resolved from the repository root.
# The script clones/updates it, pushes main, then removes it by default.
APP_DIR=tmp/app-firestartr
APP_DIR_CLEANUP=yes

# Optional prompt defaults.
PLATFORM=firestartr-pre
TENANT=prefapp-demo
ENVIRONMENT=pre
SNAPSHOT_BRANCH=
SNAPSHOT_VERSION=

# Snapshot flavor to deploy. Default is full-aws; override only for non-AWS orgs/tests.
IMAGE_FLAVOR=full-aws
