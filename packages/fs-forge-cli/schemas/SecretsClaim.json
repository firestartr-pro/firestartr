{
  "type": "object",
  "description": "A Secrets claim",
  "x-fs-forge-icon": { "emoji": "🔑", "ascii": "[SEC]" },
  "x-fs-forge-summary": "Manage external secrets for a platform resource.",
  "unevaluatedProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "system": {
      "type": "string",
      "pattern": "^system:[^:]+$"
    },
    "owner": {
      "type": "string",
      "pattern": "^[^:]+:[^:]+$"
    },
    "providers": {
      "type": "object",
      "properties": {
        "external_secrets": {
          "type": "object",
          "description": "A external secrets claim provider",
          "allOf": [
            {
              "type": "object",
              "description": "An envelope for a any kind of claim",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": true,
              "required": ["name"]
            },
            {
              "type": "object",
              "anyOf": [
                {
                  "properties": {
                    "externalSecrets": {
                      "type": "object",
                      "properties": {
                        "refreshInterval": {
                          "type": "string"
                        },
                        "secrets": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "secretName": {
                                "type": "string"
                              },
                              "remoteRef": {
                                "type": "string"
                              }
                            },
                            "required": ["secretName"],
                            "additionalProperties": false
                          }
                        }
                      }
                    },
                    "secretStore": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["SecretStore", "ClusterSecretStore"]
                        }
                      },
                      "required": ["name"]
                    }
                  },
                  "required": ["secretStore", "externalSecrets"]
                },
                {
                  "properties": {
                    "pushSecrets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "data": {
                            "type": "object"
                          },
                          "template": {
                            "type": "object"
                          },
                          "secretName": {
                            "type": "string"
                          },
                          "refreshInterval": {
                            "type": "string"
                          },
                          "generator": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string",
                                "enum": [
                                  "ACRAccessToken",
                                  "ClusterGenerator",
                                  "ECRAuthorizationToken",
                                  "Fake",
                                  "GCRAccessToken",
                                  "GithubAccessToken",
                                  "QuayAccessToken",
                                  "Password",
                                  "STSSessionToken",
                                  "UUID",
                                  "VaultDynamicSecret",
                                  "Webhook",
                                  "Grafana"
                                ]
                              },
                              "apiVersion": {
                                "type": "string"
                              },
                              "conversionStrategy": {
                                "type": "string"
                              },
                              "outputKey": {
                                "type": "string"
                              }
                            },
                            "required": ["name"]
                          }
                        },
                        "required": ["secretName", "generator"]
                      }
                    },
                    "secretStore": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["SecretStore", "ClusterSecretStore"]
                        }
                      },
                      "required": ["name"]
                    }
                  },
                  "required": ["secretStore", "pushSecrets"]
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": ["external_secrets"]
    },
    "profile": {
      "type": "object",
      "description": "A profile for a claim",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "picture": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9/.-]+$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["name", "kind", "providers"]
}
