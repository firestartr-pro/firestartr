{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandHelpJson",
  "description": "The machine-readable output of a fs-forge command's --help --json invocation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "usage": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "examples": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "args": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "multiple": {
            "type": "boolean"
          }
        },
        "required": ["name", "required", "multiple"]
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "conditionalRequired": {
            "type": "boolean"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "multiple": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "type",
          "required",
          "conditionalRequired",
          "multiple"
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {}
    }
  },
  "required": [
    "id",
    "aliases",
    "description",
    "summary",
    "args",
    "flags",
    "relationships"
  ]
}
